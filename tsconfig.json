{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "build",
    "types": ["node"]
  },
  "include": [
    "bank/**/*.ts",
    "notifications/**/*.ts",
    "crm/**/*.ts",
    "durable-bank/**/*.ts",
    "test/**/*.ts"
  ]
}
